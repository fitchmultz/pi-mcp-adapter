{
  "name": "@fitchmultz/pi-mcp-adapter",
  "version": "8.0.6",
  "description": "Token-efficient MCP adapter for the Pi coding agent",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/public-types.d.ts",
      "default": "./dist/public-types.js"
    }
  },
  "license": "MIT",
  "author": "Mitch Fultz",
  "homepage": "https://github.com/fitchmultz/pi-mcp-adapter",
  "bugs": "https://github.com/fitchmultz/pi-mcp-adapter/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "fitch-mcp-adapter": "cli.js"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:bridge": "node ./scripts/build-app-bridge.mjs",
    "prepare": "node ./scripts/prepare.mjs",
    "check:compat": "node scripts/compat-host.mjs && npm run build && npm run typecheck && vitest run --exclude __tests__/interactive-visualizer-server.test.ts && npm run test:oauth && node scripts/compat-package-smoke.mjs",
    "typecheck": "node ./scripts/tsc.mjs --noEmit",
    "typecheck:all": "node ./scripts/typecheck-all.mjs",
    "test": "vitest run && npm run test:oauth",
    "test:watch": "vitest",
    "test:oauth": "PI_MCP_ADAPTER_TEST_AUTH_STORE=memory node --test --test-concurrency=1 mcp-auth.test.ts mcp-auth-flow.test.ts mcp-callback-server.test.ts mcp-oauth-provider.test.ts",
    "test:conformance": "bash conformance/run.sh",
    "lint": "oxlint --deny-warnings .",
    "lint:conformance": "oxlint --deny-warnings conformance",
    "lint:prompts": "oxlint --deny-warnings __tests__/prompts.test.ts __tests__/prompts-sdk-integration.test.ts __tests__/test-state.ts __tests__/test-extension-context.ts",
    "lint:agent": "oxlint --deny-warnings --format=agent .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-mcp-adapter.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-agent",
    "extension",
    "claude",
    "llm"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ],
    "video": "https://github.com/fitchmultz/pi-mcp-adapter/raw/refs/heads/main/pi-mcp.mp4"
  },
  "files": [
    "dist",
    "cli.js",
    "skills",
    "docs/client-metadata.json",
    "README.md",
    "OAUTH.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@napi-rs/keyring": "2.1.0",
    "cross-spawn": "7.0.6",
    "minisearch": "7.2.0",
    "open": "11.0.4",
    "smol-toml": "1.9.1",
    "strip-json-comments": "5.0.3",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "packageManager": "npm@12.2.0"
}
