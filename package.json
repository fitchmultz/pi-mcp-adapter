{
  "name": "@fitchmultz/pi-mcp-adapter",
  "version": "7.0.0",
  "description": "Fitch's independently maintained MCP adapter for Pi coding agent",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "license": "MIT",
  "author": "Mitch Fultz",
  "contributors": [
    "Nico Bailon"
  ],
  "homepage": "https://github.com/fitchmultz/pi-mcp-adapter",
  "bugs": "https://github.com/fitchmultz/pi-mcp-adapter/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "fitch-mcp-adapter": "cli.js"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:bridge": "node ./scripts/build-app-bridge.mjs",
    "prepare": "node ./scripts/prepare.mjs",
    "check:compat": "node scripts/compat-host.mjs && npm run build && npm run typecheck && vitest run --exclude __tests__/interactive-visualizer-server.test.ts && npm run test:oauth && node scripts/compat-package-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:oauth",
    "test:watch": "vitest",
    "test:oauth": "PI_MCP_ADAPTER_TEST_AUTH_STORE=memory node --test --test-concurrency=1 mcp-auth.test.ts mcp-auth-flow.test.ts mcp-callback-server.test.ts mcp-oauth-provider.test.ts",
    "test:conformance": "bash conformance/run.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-mcp-adapter.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-agent",
    "extension",
    "claude",
    "llm"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ],
    "video": "https://github.com/fitchmultz/pi-mcp-adapter/raw/refs/heads/main/pi-mcp.mp4"
  },
  "files": [
    "dist",
    "cli.js",
    "skills",
    "docs/client-metadata.json",
    "README.md",
    "OAUTH.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@modelcontextprotocol/core": "2.1.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@napi-rs/keyring": "2.1.0",
    "cross-spawn": "7.0.6",
    "minisearch": "7.2.0",
    "open": "11.0.4",
    "smol-toml": "1.9.0",
    "strip-json-comments": "5.0.3",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@modelcontextprotocol/server": "2.1.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "typebox": "1.3.34",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "packageManager": "npm@12.1.0"
}
