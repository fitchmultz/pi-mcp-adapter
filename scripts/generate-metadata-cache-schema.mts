import { execFileSync } from "node:child_process";
import { hash } from "node:crypto";
import { readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { fileURLToPath } from "node:url";
import { PromptSchema, ResourceSchema, ToolSchema } from "@modelcontextprotocol/core";
import { z } from "zod";

const root = fileURLToPath(new URL("../", import.meta.url));
const outputPath = join(root, "metadata-cache-validator.ts");

// Version-1 tools may lack inputSchema and carry flattened UI metadata. Prompts
// persist only the fields serializePrompts writes. All native fields come from SDK schemas.
const cacheEntrySchema = z.object({
  configHash: z.string(),
  cachedAt: z.number().positive(),
  instructions: z.string().optional(),
  tools: z.array(
    ToolSchema.partial({ inputSchema: true }).extend({
      uiResourceUri: z.string().optional(),
      uiVisibility: z.array(z.enum(["model", "app"])).optional(),
      uiStreamMode: z.enum(["eager", "stream-first"]).optional(),
    }),
  ),
  resources: z.array(ResourceSchema),
  prompts: z
    .array(PromptSchema.pick({ name: true, title: true, description: true, arguments: true }))
    .optional(),
});

function version(path: URL): string {
  const raw: unknown = JSON.parse(readFileSync(path, "utf8"));
  return z.object({ version: z.string() }).parse(raw).version;
}

const provenance = {
  sdk: version(new URL("../package.json", import.meta.resolve("@modelcontextprotocol/core"))),
  zod: version(new URL("./package.json", import.meta.resolve("zod"))),
  oxfmt: version(new URL(import.meta.resolve("oxfmt/package.json"))),
};
const input = z.toJSONSchema(cacheEntrySchema, { io: "input" });
// Output conversion also fails on unrepresentable transforms instead of silently
// exporting a validation-only approximation. Check validates raw inputs, not parsed outputs.
const output = z.toJSONSchema(cacheEntrySchema, { io: "output" });
const digest = hash("sha256", JSON.stringify({ input, output }), "hex");
const source = `// Generated by scripts/generate-metadata-cache-schema.mts. Do not edit.
// SDK/Zod/Oxfmt: ${JSON.stringify(provenance)}
// Input/output contract SHA-256: ${digest}
// Validate persisted input without stripping unknown fields or replacing references.
import { Compile } from "typebox/compile";

export const cacheEntryValidator = Compile(${JSON.stringify(input)});
`;
const formatted = execFileSync(
  process.execPath,
  [
    fileURLToPath(new URL("../bin/oxfmt", import.meta.resolve("oxfmt"))),
    "--stdin-filepath",
    outputPath,
  ],
  { cwd: root, input: source, encoding: "utf8" },
);
if (process.argv.includes("--check")) {
  if (readFileSync(outputPath, "utf8") !== formatted) {
    throw new Error("Metadata cache schema is stale; run npm run generate:cache-schema");
  }
} else {
  writeFileSync(outputPath, formatted);
}
